const Essay = lazy(() => import('../tasks/Essay'));
const Assessment = lazy(() => import('../tasks/Assessment'));
const Notes = lazy(() => import('../tasks/Notes'));
const Games = lazy(() => import('../tasks/Games'));

const THEMES = {
  Y8: { banner: 'bg-indigo-500 border-indigo-700', text: 'text-indigo-600 dark:text-indigo-400', ambient1: 'bg-indigo-400', ambient2: 'bg-purple-500', glow: 'hover:border-indigo-400 dark:hover:border-indigo-600' },
