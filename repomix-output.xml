              >
                <span className="hidden sm:inline">
                  {currentIdx === totalQuestions - 1 ? (lang === 'vn' ? 'Nộp Bài' : 'Submit') : (lang === 'vn' ? 'Tiếp Theo' : 'Continue')}
                </span>
                <span className="sm:hidden">
                  {currentIdx === totalQuestions - 1 ? 'Submit' : 'Next'}
