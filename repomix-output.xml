                      <div className="space-y-4 text-slate-700 dark:text-slate-300 text-lg leading-relaxed font-medium">
                        {((lang === 'vn' && currentPassage.vnText ? currentPassage.vnText : currentPassage.text) || "").split('\n').map((p, i) => (
