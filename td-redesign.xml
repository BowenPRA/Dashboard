import React, { useMemo } from 'react';
import { ENEMIES, TOWERS, getEffectiveStats } from './gameData';
import TowerVisual from './TowerVisual';
import UpgradeBadges from './UpgradeBadges';

export const CELL_SIZE = 48;

const DECO_SYMBOLS = ['🌿', '🌸', '🍄'];

export default function GameBoard({
  layout,
  towers,
  creeps,
  projectiles,
  floaters,
  particles,
  burnZones,
  decorations,
  selectedTowerId,
  hoveredTowerId,
  activeBuilder,
  hoverCell,
  onCellClick,
  onCellHover,
  onCellLeave,
  onTowerClick
}) {
  const { rows, cols, path } = layout;
  const width = cols * CELL_SIZE;
  const height = rows * CELL_SIZE;

  const pathCellSet = useMemo(() => {
    const s = new Set();
    for (let i = 0; i < path.length - 1; i++) {
      const [r1, c1] = path[i];
      const [r2, c2] = path[i + 1];
      const minR = Math.min(r1, r2), maxR = Math.max(r1, r2);
      const minC = Math.min(c1, c2), maxC = Math.max(c1, c2);
      for (let r = minR; r <= maxR; r++) {
        for (let c = minC; c <= maxC; c++) s.add(`${r}_${c}`);
      }
    }
    return s;
  }, [path]);

  const pathPoints = useMemo(() =>
    path.map(([r, c]) => `${c * CELL_SIZE + CELL_SIZE / 2},${r * CELL_SIZE + CELL_SIZE / 2}`).join(' ')
  , [path]);

  const startCell = path[0];
  const endCell = path[path.length - 1];

  const rangeTower = towers.find(t => t.id === selectedTowerId)
                  || towers.find(t => t.id === hoveredTowerId);
  const rangeStats = rangeTower ? getEffectiveStats(rangeTower) : null;
  const rangeVal = rangeStats ? (rangeStats.range || rangeStats.auraRange) : 0;

  return (
    <div
      className="relative rounded-3xl overflow-hidden border-4 border-emerald-300 shadow-xl"
      style={{
        width,
        height,
        background:
          'radial-gradient(circle at 20% 20%, #d9f99d 0%, #bef264 40%, #84cc16 100%)'
      }}
      onMouseLeave={onCellLeave}
    >
      <style>{`
        @keyframes td-pop-in {
          0% { transform: scale(0) translateY(-12px); }
          70% { transform: scale(1.12) translateY(0); }
          100% { transform: scale(1) translateY(0); }
        }
        .td-pop-in { animation: td-pop-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
      `}</style>

      <svg className="absolute inset-0 pointer-events-none opacity-25" width={width} height={height}>
        <defs>
          <pattern id="td-grass" width={CELL_SIZE} height={CELL_SIZE} patternUnits="userSpaceOnUse">
            <path d={`M ${CELL_SIZE} 0 L 0 0 0 ${CELL_SIZE}`} fill="none" stroke="rgba(255,255,255,0.4)" strokeWidth="0.5" />
          </pattern>
        </defs>
        <rect width={width} height={height} fill="url(#td-grass)" />
      </svg>

      <div className="absolute inset-0">
        {Array.from({ length: rows }).map((_, r) =>
          Array.from({ length: cols }).map((_, c) => {
            const isPath = pathCellSet.has(`${r}_${c}`);
            return (
              <div
                key={`${r}_${c}`}
                onClick={() => onCellClick(r, c, isPath)}
                onMouseEnter={() => onCellHover(r, c, isPath)}
                className="absolute cursor-pointer"
                style={{
                  left: c * CELL_SIZE,
                  top: r * CELL_SIZE,
                  width: CELL_SIZE,
                  height: CELL_SIZE
                }}
              />
            );
          })
        )}
      </div>

      {decorations.map(d => (
        <div
          key={`dec_${d.id}`}
          className="absolute pointer-events-none select-none opacity-80"
          style={{
            left: d.col * CELL_SIZE + CELL_SIZE / 2,
            top: d.row * CELL_SIZE + CELL_SIZE / 2,
            transform: 'translate(-50%, -50%)',
            fontSize: 18
          }}
        >
          {DECO_SYMBOLS[d.variant] || '🌿'}
        </div>
      ))}

      <svg className="absolute inset-0 pointer-events-none" width={width} height={height}>
        <polyline
          points={pathPoints}
          fill="none"
          stroke="#b45309"
          strokeWidth={CELL_SIZE - 2}
          strokeLinejoin="round"
          strokeLinecap="round"
        />
        <polyline
          points={pathPoints}
          fill="none"
          stroke="#fbbf24"
          strokeWidth={CELL_SIZE - 12}
          strokeLinejoin="round"
          strokeLinecap="round"
        />
        <polyline
          points={pathPoints}
          fill="none"
          stroke="#fde68a"
          strokeWidth={CELL_SIZE - 24}
          strokeLinejoin="round"
          strokeLinecap="round"
          strokeDasharray="6 14"
          opacity={0.55}
        />
      </svg>

      <PortalMarker row={startCell[0]} col={startCell[1]} kind="in" />
      <PortalMarker row={endCell[0]} col={endCell[1]} kind="out" />

      {burnZones.map(z => (
        <div
          key={z.id}
          className="absolute pointer-events-none rounded-full"
          style={{
            left: z.col * CELL_SIZE + CELL_SIZE / 2 - z.radius * CELL_SIZE,
            top: z.row * CELL_SIZE + CELL_SIZE / 2 - z.radius * CELL_SIZE,
            width: z.radius * 2 * CELL_SIZE,
            height: z.radius * 2 * CELL_SIZE,
            background: 'radial-gradient(circle, rgba(239,68,68,0.55) 0%, rgba(239,68,68,0.15) 60%, transparent 100%)',
            opacity: Math.min(1, z.life / z.maxLife)
          }}
        />
      ))}

      {rangeTower && rangeStats && rangeVal > 0 && (
        <div
          className="absolute pointer-events-none rounded-full border-4 border-white border-dashed"
          style={{
            left: rangeTower.col * CELL_SIZE + CELL_SIZE / 2 - rangeVal * CELL_SIZE,
            top: rangeTower.row * CELL_SIZE + CELL_SIZE / 2 - rangeVal * CELL_SIZE,
            width: rangeVal * 2 * CELL_SIZE,
            height: rangeVal * 2 * CELL_SIZE,
            background: 'rgba(255,255,255,0.18)'
          }}
        />
      )}

      {activeBuilder && hoverCell.row >= 0 && (() => {
        const tConf = TOWERS[activeBuilder.typeId];
        if (!tConf) return null;
        const range = tConf.base.range || tConf.base.auraRange || 0;
        return (
          <>
            {range > 0 && (
              <div
                className="absolute pointer-events-none rounded-full border-4 border-dashed"
                style={{
                  left: hoverCell.col * CELL_SIZE + CELL_SIZE / 2 - range * CELL_SIZE,
                  top: hoverCell.row * CELL_SIZE + CELL_SIZE / 2 - range * CELL_SIZE,
                  width: range * 2 * CELL_SIZE,
                  height: range * 2 * CELL_SIZE,
                  borderColor: hoverCell.valid ? 'rgba(255,255,255,0.9)' : 'rgba(239,68,68,0.9)',
                  background: hoverCell.valid ? 'rgba(255,255,255,0.18)' : 'rgba(239,68,68,0.18)'
                }}
              />
            )}
            <div
              className="absolute pointer-events-none flex items-center justify-center"
              style={{
                left: hoverCell.col * CELL_SIZE,
                top: hoverCell.row * CELL_SIZE,
                width: CELL_SIZE,
                height: CELL_SIZE,
                opacity: hoverCell.valid ? 0.85 : 0.4
              }}
            >
              <TowerVisual typeId={activeBuilder.typeId} size="md" dimmed={!hoverCell.valid} />
            </div>
          </>
        );
      })()}

      {towers.map(t => {
        const isSelected = selectedTowerId === t.id;
        const isHovered = hoveredTowerId === t.id;

        return (
          <div
            key={t.id}
            onClick={(e) => { e.stopPropagation(); onTowerClick(t.id); }}
            className="absolute cursor-pointer td-pop-in"
            style={{
              left: t.col * CELL_SIZE,
              top: t.row * CELL_SIZE,
              width: CELL_SIZE,
              height: CELL_SIZE
            }}
          >
            <div className="relative w-full h-full flex items-center justify-center">
              <UpgradeBadges upgrades={t.upgrades} />
              <TowerVisual typeId={t.typeId} size="md" selected={isSelected} hovered={isHovered} />
            </div>
          </div>
        );
      })}

      {projectiles.map(p => (
        <div
          key={p.id}
          className="absolute pointer-events-none"
          style={{
            left: p.col * CELL_SIZE + CELL_SIZE / 2,
            top: p.row * CELL_SIZE + CELL_SIZE / 2,
            transform: 'translate(-50%, -50%)'
          }}
        >
          {p.kind === 'CHAIN' ? (
            <svg width={(p.range || 6) * CELL_SIZE * 2} height={(p.range || 6) * CELL_SIZE * 2}
                 className="absolute pointer-events-none"
                 style={{ left: -(p.range || 6) * CELL_SIZE, top: -(p.range || 6) * CELL_SIZE }}>
              {(p.lines || []).map((ln, i) => (
                <line key={i}
                      x1={(p.range || 6) * CELL_SIZE}
                      y1={(p.range || 6) * CELL_SIZE}
                      x2={(ln.col - p.col) * CELL_SIZE + (p.range || 6) * CELL_SIZE}
                      y2={(ln.row - p.row) * CELL_SIZE + (p.range || 6) * CELL_SIZE}
                      stroke="#fde047" strokeWidth="3" opacity={p.life / p.maxLife} />
              ))}
            </svg>
          ) : p.kind === 'LANCE' ? (
            <div
              className="absolute bg-emerald-300"
              style={{
                width: p.length * CELL_SIZE,
                height: 4,
                transform: `translate(0, -2px) rotate(${p.angle}rad)`,
                transformOrigin: '0 50%',
                opacity: p.life / p.maxLife,
                boxShadow: '0 0 8px #34d399'
              }}
            />
          ) : (
            <div
              className="rounded-full"
              style={{
                width: p.kind === 'SPLASH' ? 10 : 6,
                height: p.kind === 'SPLASH' ? 10 : 6,
                background: p.color || '#fff',
                boxShadow: `0 0 8px ${p.color || '#fff'}`,
                transform: 'translate(-50%, -50%)'
              }}
            />
          )}
        </div>
      ))}

      {particles.map(p => (
        <div
          key={p.id}
          className="absolute pointer-events-none rounded-full"
          style={{
            left: p.col * CELL_SIZE + CELL_SIZE / 2 - p.radius * CELL_SIZE,
            top: p.row * CELL_SIZE + CELL_SIZE / 2 - p.radius * CELL_SIZE,
            width: p.radius * 2 * CELL_SIZE,
            height: p.radius * 2 * CELL_SIZE,
            background: p.color || 'rgba(255,255,255,0.5)',
            opacity: p.life / p.maxLife,
            transform: `scale(${1 - p.life / p.maxLife * 0.3})`
          }}
        />
      ))}

      {creeps.map(c => {
        const eConf = ENEMIES[c.typeKey];
        if (!eConf) return null;
        const hpPct = Math.max(0, c.hp / c.maxHp);
        return (
          <div
            key={c.id}
            className="absolute pointer-events-none"
            style={{
              left: c.col * CELL_SIZE + CELL_SIZE / 2,
              top: c.row * CELL_SIZE + CELL_SIZE / 2,
              transform: 'translate(-50%, -50%)'
            }}
          >
            <div
              className={`rounded-full ${eConf.color} border-2 ${eConf.border} flex items-center justify-center shadow-md`}
              style={{
                width: eConf.radius * 2,
                height: eConf.radius * 2,
                fontSize: eConf.radius,
                filter: c.freezeTimer > 0 ? 'brightness(0.7) hue-rotate(180deg)' : 'none'
              }}
            >
              <span style={{ fontSize: eConf.radius * 1.1 }}>{eConf.emoji}</span>
            </div>
            <div className="absolute left-1/2 -translate-x-1/2 -top-2 w-10 h-1.5 bg-black/40 rounded-full overflow-hidden border border-white/40">
              <div
                className="h-full"
                style={{
                  width: `${hpPct * 100}%`,
                  background: hpPct > 0.5 ? '#22c55e' : hpPct > 0.25 ? '#f59e0b' : '#ef4444'
                }}
              />
            </div>
            {c.freezeTimer > 0 && (
              <div className="absolute -top-3 left-1/2 -translate-x-1/2 text-xs">❄️</div>
            )}
            {c.burning > 0 && (
              <div className="absolute -top-3 left-1/2 -translate-x-1/2 text-xs">🔥</div>
            )}
          </div>
        );
      })}

      {floaters.map(f => (
        <div
          key={f.id}
          className={`absolute pointer-events-none font-black text-sm ${f.colorClass}`}
          style={{
            left: f.col * CELL_SIZE + CELL_SIZE / 2,
            top: f.row * CELL_SIZE + CELL_SIZE / 2 - (1 - f.life / f.maxLife) * 30,
            transform: 'translate(-50%, -50%)',
            opacity: f.life / f.maxLife,
            textShadow: '0 1px 2px rgba(0,0,0,0.6)'
          }}
        >
          {f.text}
        </div>
      ))}
    </div>
  );
}

function PortalMarker({ row, col, kind }) {
  const isIn = kind === 'in';
  const bg = isIn ? 'bg-emerald-400' : 'bg-rose-400';
  const ring = isIn ? 'border-emerald-700' : 'border-rose-700';
  const label = isIn ? 'IN' : 'OUT';
  return (
    <div
      className="absolute pointer-events-none flex items-center justify-center"
      style={{
        left: col * CELL_SIZE,
        top: row * CELL_SIZE,
        width: CELL_SIZE,
        height: CELL_SIZE
      }}
    >
      <div
        className={`w-10 h-10 rounded-full ${bg} border-4 ${ring} shadow-lg flex items-center justify-center text-white font-black text-xs tracking-wider animate-pulse`}
      >
        {label}
      </div>
    </div>
  );
}
