<file path="src/components/towerdefense/BuildMenu.jsx">
import React from 'react';
import { Coins, Hammer } from 'lucide-react';
import { TOWERS, TOWER_ORDER } from './gameData';
import TowerVisual from './TowerVisual';

export default function BuildMenu({ allowedTowers, credits, activeBuilder, onSelect }) {
  const ids = TOWER_ORDER.filter(id => allowedTowers.includes(id));

  return (
    <div className="bg-white rounded-3xl border border-slate-200 shadow-sm p-4">
      <div className="flex items-center gap-2 mb-3 px-1">
        <div className="w-7 h-7 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-500">
          <Hammer className="w-4 h-4" strokeWidth={2.5} />
        </div>
        <span className="text-xs uppercase tracking-widest font-black text-slate-500">
          Tap a tower, then drop it on the grass
        </span>
      </div>

      <div className="flex gap-3 overflow-x-auto pb-1">
        {ids.map(id => {
          const t = TOWERS[id];
          if (!t) return null;
          const canAfford = credits >= t.cost;
          const isSelected = activeBuilder?.typeId === id;

          let stateClass;
          if (isSelected) {
            stateClass = 'bg-indigo-50 border-indigo-300 ring-4 ring-indigo-200';
          } else if (canAfford) {
            stateClass = 'bg-white border-slate-200 hover:border-indigo-300 hover:-translate-y-0.5 border-b-4 active:border-b-0 active:translate-y-1';
          } else {
            stateClass = 'bg-slate-50 border-slate-200 opacity-50 cursor-not-allowed border-b-4';
          }

          return (
            <button
              key={id}
              onClick={() => canAfford && onSelect({ typeId: id })}
              disabled={!canAfford}
              title={t.desc}
              className={`group relative flex-shrink-0 w-32 rounded-3xl p-3 text-left transition-all border-2 ${stateClass}`}
            >
              {/* Cost chip */}
              <div className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full mb-2 text-xs font-black border
                ${canAfford
                  ? 'bg-amber-50 text-amber-700 border-amber-200'
                  : 'bg-slate-100 text-slate-400 border-slate-200'}`}>
                <Coins className="w-3 h-3" />
                {t.cost}
              </div>

              {/* Tower preview pedestal */}
              <div className="rounded-2xl bg-gradient-to-b from-lime-100 to-lime-200 border border-lime-300 flex items-center justify-center py-3 mb-2">
                <TowerVisual typeId={id} size="lg" dimmed={!canAfford} />
              </div>

              <div className="text-center font-black text-sm leading-tight text-slate-800">
                {t.name}
              </div>

              {/* Stats */}
              <div className="flex justify-around mt-2 text-xs font-bold text-slate-500">
                {t.type === 'BUFF' ? (
                  <>
                    <MiniStat label="AURA" value={t.base.auraRange} />
                    <MiniStat label="BUFF" value={`+${Math.round((1 - t.base.buff) * 100)}%`} />
                  </>
                ) : (
                  <>
                    <MiniStat label="DMG" value={t.base.damage ?? '—'} />
                    <MiniStat label="RNG" value={t.base.range} />
                    <MiniStat label="CD"  value={`${(t.base.cooldown / 1000).toFixed(1)}s`} />
                  </>
                )}
              </div>
            </button>
          );
        })}
      </div>
    </div>
  );
}

function MiniStat({ label, value }) {
  return (
    <div className="flex flex-col items-center">
      <div className="text-sm font-black text-slate-700">{value}</div>
      <div className="text-[9px] tracking-widest text-slate-400 font-black">{label}</div>
    </div>
  );
}
</file>

