  DART:   { Icon: Crosshair, body: 'from-sky-400 to-sky-600',         ring: 'ring-sky-300' },
  SNIPER: { Icon: Target,    body: 'from-emerald-400 to-emerald-600', ring: 'ring-emerald-300' },
