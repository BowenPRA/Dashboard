  NITRO:  { Icon: Cog,       body: 'from-yellow-300 to-yellow-500',   ring: 'ring-yellow-300' }
};

const SIZES = {
  sm: { wrap: 'w-8 h-8',  body: 'w-7 h-7',  icon: 'w-4 h-4'  },
  md: { wrap: 'w-10 h-10', body: 'w-9 h-9',  icon: 'w-5 h-5'  },
  lg: { wrap: 'w-14 h-14', body: 'w-12 h-12', icon: 'w-7 h-7'  },
  xl: { wrap: 'w-20 h-20', body: 'w-16 h-16', icon: 'w-10 h-10' }
};

export default function TowerVisual({ typeId, size = 'md', selected = false, hovered = false, dimmed = false }) {
