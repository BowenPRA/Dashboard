        {/* 2. The Main Menu */}
        <Route path="/home" element={<Home />} />
        
        {/* 3. The Curricular Tracks */}
        <Route path="/Y8" element={<YearDashboard track="Y8" />} />
        <Route path="/Y9" element={<YearDashboard track="Y9" />} />
